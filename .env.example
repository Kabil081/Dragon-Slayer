# Settings for the game's server (tools/serve.py). Copy this file to .env and
# change what you need. A real environment variable of the same name wins,
# which is how hosting services pass settings. Never commit or share .env.

# ---- where the server listens --------------------------------------------
# 127.0.0.1 = only this PC. 0.0.0.0 = anyone who can reach this PC (your home
# network, or the internet when hosted online).
DS_HOST=127.0.0.1
# Hosting services set PORT themselves; that one wins over DS_PORT.
DS_PORT=8642

# ---- the database ---------------------------------------------------------
# Empty: a local SQLite file (DS_DB_PATH), no setup or password needed.
# For an online leaderboard on a host whose disk is wiped on restart, put a
# Postgres connection string here (Neon, Supabase, Render, Railway...) and
# install the driver once:  pip install "psycopg[binary]"
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=
DS_DB_PATH=data/dragonslayer.sqlite3

# ---- accounts -------------------------------------------------------------
# Days a sign-in lasts on one browser.
DS_SESSION_DAYS=30
# 1 = anyone can create an account, 0 = existing accounts only.
DS_ALLOW_SIGNUP=1
# Secure cookies: auto (when the host says the page came over https), 1, or 0.
DS_COOKIE_SECURE=auto
# 1 only behind a hosting service's proxy (Render, Railway, Fly, nginx): trusts
# its X-Forwarded-For / X-Forwarded-Proto headers.
DS_TRUST_PROXY=0
# The most players watching the live leaderboard at once.
DS_MAX_LIVE=200
